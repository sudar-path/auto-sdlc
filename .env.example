# Environment variables for local runs. None of the scripts load this file automatically:
# export a value in your shell or prefix a single command, e.g.
#   FAULT=schema_drift python upstream/generate.py
#
# FAULT is read ONLY by upstream/generate.py (the simulated orders system). It changes the
# order files that upstream writes; pipeline/run.py and tools/totals.py never read it.
#   none          (default) well-formed orders
#   schema_drift  every order has "total_amount" instead of "order_total"
#   null_spike    ~30% of orders have "customer_id": null
FAULT=none
